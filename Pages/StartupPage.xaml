<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyTool.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyTool.Pages"
    xmlns:models="using:MyTool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="25" Padding="10">

            <StackPanel Spacing="5">
                <TextBlock Text="STARTUP MANAGER" FontSize="24" FontWeight="Bold" Foreground="#F4F4F5" CharacterSpacing="50"/>
                <TextBlock Text="Manage applications that launch automatically when Windows starts." FontSize="13" Foreground="#71717A"/>
            </StackPanel>

            <!-- Summary & Refresh Bar -->
            <Grid HorizontalAlignment="Left" MaxWidth="1000" Width="Auto" MinWidth="600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="18" Height="18" Foreground="#A3E635"/>
                    <TextBlock x:Name="StartupSummaryText" Text="Scanning startup entries..." FontSize="13" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="RefreshButton" Click="Refresh_Click" Background="#1A1A22" Foreground="#F4F4F5" BorderBrush="#2D2D3D" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" Foreground="#A3E635" FontSize="14" FontFamily="Segoe MDL2 Assets"/>
                        <TextBlock Text="Refresh" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Startup Items List -->
            <ItemsControl x:Name="StartupItemsList" HorizontalAlignment="Left" MaxWidth="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StartupItem">
                        <Border HorizontalAlignment="Stretch" Background="#141419" BorderBrush="#22222C" BorderThickness="1" CornerRadius="12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,30,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE71D;" Foreground="#A3E635" FontSize="15" FontFamily="Segoe MDL2 Assets"/>
                                        <TextBlock Text="{x:Bind Name}" Foreground="#F4F4F5" FontSize="15" FontWeight="SemiBold"/>
                                        <Border Background="#1A1A22" BorderBrush="#2D2D3D" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Source}" Foreground="#A1A1AA" FontSize="10" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Command}" FontSize="11" Foreground="#71717A" FontFamily="Consolas" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                  Tag="{x:Bind}"
                                                  Toggled="ItemToggle_Toggled"
                                                  OnContent="Enabled"
                                                  OffContent="Disabled"
                                                  MinWidth="110"/>
                                    <Button Tag="{x:Bind}" Click="DeleteItem_Click" Background="#1A1A22" BorderBrush="#2D2D3D" CornerRadius="6" Padding="8" ToolTipService.ToolTip="Remove startup entry">
                                        <FontIcon Glyph="&#xE74D;" Foreground="#EF4444" FontSize="14" FontFamily="Segoe MDL2 Assets"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
